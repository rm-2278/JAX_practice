    mid_ax = axes_row[len(grads) // 2]
    mid_ax.text(
        0.5,
        1.25,
        f"{act_fn_label} activation",
        transform=mid_ax.transAxes, # Change axes to 0,0 ~ 1,1
        ha="center", # Set the text to anchor at the center horizontally
